# Firebase コンソール > プロジェクトの設定 > マイアプリ(ウェブアプリ)で発行される値をコピーする。
# これらはクライアントに公開される値なので秘密情報ではない(Firebaseのセキュリティは
# firestore.rules / storage.rules 側で担保する)。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Stripe の設定(シークレット・price ID・Webhook)がすべて済んでから "true" にする。
# true にしない限り、プラン画面に申し込みボタンは出ない(押しても失敗する導線を
# ユーザーに見せないため)。値そのものは秘密ではない。
NEXT_PUBLIC_BILLING_ENABLED=false
