rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /closet/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /outfits/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /faces/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // composed/ は Cloud Functions (composeOutfitImage) が Admin SDK で書き込み、
    // 公開URLとして配信する。クライアントからの直接書き込みは禁止。
    match /composed/{uid}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
