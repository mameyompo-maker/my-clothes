rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /closet/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /outfits/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // styles/ は全身写真の投稿。公開範囲の判定は Firestore の stylePosts 側で行うので、
    // ここはサインイン済みなら読める。ここのルールが無いと投稿が丸ごと失敗する。
    match /styles/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // avatars/ はプロフィール画像。誰のプロフィールからも表示するので読みは全員可。
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /faces/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // composed/ は Cloud Functions (composeOutfitImage) が Admin SDK で書き込み、
    // 公開URLとして配信する。クライアントからの直接書き込みは禁止。
    match /composed/{uid}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
