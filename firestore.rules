rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isFriendOf(uid) {
      return me() in get(/databases/$(database)/documents/users/$(uid)).data.friendUids;
    }

    // users: 自分のドキュメントは自由。他人のドキュメントに触れるのは次の2つだけ。
    //  1. 招待コードで「自分自身をfriendUidsに追加する」(Cloud Functions不要で友達追加を完結させる)
    //  2. フォロー時に相手の followerCount を1増減する
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && me() == uid
        && !request.resource.data.keys().hasAny(['plan', 'official']);

      // 自分のドキュメントでも 'plan' と 'official' だけは触らせない。
      // plan は自己申告で有料機能が開いてしまうため、決済確認後に Admin SDK が書く。
      // official は認証バッジ。自分で付けられたら認証の意味が無くなるので運営だけが書く。
      allow update: if isSignedIn() && me() == uid
        && !changedKeys().hasAny(['plan', 'official']);

      allow update: if isSignedIn() && me() != uid
        && changedKeys().hasOnly(['friendUids'])
        && request.resource.data.friendUids.size() == resource.data.friendUids.size() + 1
        && request.resource.data.friendUids.hasAll(resource.data.friendUids)
        && me() in request.resource.data.friendUids;

      // 相互フォローが解除されたとき、相手の friendUids から「自分だけ」を抜く。
      // 残った要素がすべて元からあったもので、かつ結果に自分が含まれないことを要求するため、
      // 他人を巻き添えで削ることはできない。
      allow update: if isSignedIn() && me() != uid
        && changedKeys().hasOnly(['friendUids'])
        && request.resource.data.friendUids.size() == resource.data.friendUids.size() - 1
        && resource.data.friendUids.hasAll(request.resource.data.friendUids)
        && me() in resource.data.friendUids
        && !(me() in request.resource.data.friendUids);

      allow update: if isSignedIn() && me() != uid
        && changedKeys().hasOnly(['followerCount'])
        && request.resource.data.followerCount >= 0
        && (request.resource.data.followerCount == resource.data.followerCount + 1
            || request.resource.data.followerCount == resource.data.followerCount - 1);
    }

    // notifications: 受信箱。行為者(いいねを押した人など)が相手の箱に直接書く。
    // Cloud Functions を挟まずに済ませるかわり、書ける中身をここで縛る。
    match /notifications/{recipientUid}/items/{itemId} {
      allow read, delete: if isSignedIn() && me() == recipientUid;
      // 自分が actor である通知だけ、他人の箱に入れられる。
      // 自分自身への通知は無意味なので弾く。
      allow create: if isSignedIn()
        && request.resource.data.actorUid == me()
        && recipientUid != me();
      allow update: if false;
    }

    // blocks: 自分がブロックした記録。ID を blocker__blocked に固定しているので、
    // 自分のものかどうかは ID から判定でき、余計な読み取りが要らない。
    // ブロックされた側からは読めない(ブロックされたことを気付かせないため)。
    match /blocks/{blockDocId} {
      allow read: if isSignedIn() && resource.data.blockerUid == me();
      allow create: if isSignedIn()
        && request.resource.data.blockerUid == me()
        && request.resource.data.blockedUid != me()
        && blockDocId == me() + '__' + request.resource.data.blockedUid;
      allow delete: if isSignedIn() && resource.data.blockerUid == me();
      allow update: if false;
    }

    // reports: 運営が Admin SDK で読むための投書箱。
    // **誰にも読ませない**(本人にも)。通報の有無が相手に伝わる経路を作らないため。
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == me();
      allow read, update, delete: if false;
    }

    // follows: 自分が follower である行だけ作れる/消せる。
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.followerUid == me()
        && request.resource.data.followingUid != me()
        && followId == me() + '__' + request.resource.data.followingUid;
      allow delete: if isSignedIn() && resource.data.followerUid == me();
      allow update: if false;
    }

    // closetItems: 閲覧はサインイン済みなら可(投稿のアイテムタグから辿れる必要がある)。
    // 書き込みは所有者のみ。
    match /closetItems/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == me();
      allow update, delete: if isSignedIn() && resource.data.ownerUid == me();
    }

    // facePatterns: 本人しか読み書きできない(合成は Cloud Functions が Admin SDK で読む)。
    match /facePatterns/{patternId} {
      allow read: if isSignedIn() && resource.data.ownerUid == me();
      allow create: if isSignedIn() && request.resource.data.ownerUid == me();
      allow update, delete: if isSignedIn() && resource.data.ownerUid == me();
    }

    // outfitPosts(2択): 投稿者本人 or 共有された友達だけ読める。
    match /outfitPosts/{postId} {
      // visibility は後から足したフィールドなので、古い投稿には存在しない。
      // get() の既定値で「友達だけ」として扱う。
      function isPublicOutfit() {
        return resource.data.get('visibility', 'friends') == 'public';
      }

      function canReadOutfit() {
        return resource.data.ownerUid == me()
          || me() in resource.data.sharedWithUids
          || isPublicOutfit();
      }

      allow get: if isSignedIn() && (resource == null || canReadOutfit());
      allow list: if isSignedIn() && canReadOutfit();
      allow create: if isSignedIn() && request.resource.data.ownerUid == me();
      // 「どっちを着たか」の記録と、取り消しの印だけは本人が後から書ける。
      // 合成結果は Admin SDK が書く。
      // deletedAt は物理削除の代わり。1日の取り消し回数を数える必要があるため、
      // ドキュメントを消さずに印だけ付ける(消すと数える対象が無くなる)。
      allow update: if isSignedIn() && resource.data.ownerUid == me()
        && changedKeys().hasOnly(['decidedCandidateIndex', 'deletedAt']);
      allow delete: if isSignedIn() && resource.data.ownerUid == me();

      match /votes/{voterUid} {
        allow read: if isSignedIn()
          && (get(/databases/$(database)/documents/outfitPosts/$(postId)).data.ownerUid == me()
              || me() in get(/databases/$(database)/documents/outfitPosts/$(postId)).data.sharedWithUids);
        allow create, update: if isSignedIn() && me() == voterUid
          && request.resource.data.voterUid == voterUid
          && request.resource.data.postId == postId
          && get(/databases/$(database)/documents/outfitPosts/$(postId)).data.ownerUid != me()
          // 公開されている2択は誰でも投票できる。非公開なら共有された友達だけ。
          && (get(/databases/$(database)/documents/outfitPosts/$(postId)).data.get('visibility', 'friends') == 'public'
              || me() in get(/databases/$(database)/documents/outfitPosts/$(postId)).data.sharedWithUids);
        allow delete: if false;
      }
    }

    // stylePosts(全身写真): public は誰でも、friends は友達と本人だけ。
    // 友達がいなくても public に投稿できることがこの画面の狙い。
    match /stylePosts/{postId} {
      function canReadPost() {
        return resource.data.visibility == 'public'
          || resource.data.ownerUid == me()
          || isFriendOf(resource.data.ownerUid);
      }

      // 消えた投稿を開いたときに「権限なし」ではなく「見つからない」にしたいので、
      // get だけは resource == null を許す(chatThreads と同じ理由)。
      allow get: if isSignedIn() && (resource == null || canReadPost());
      allow list: if isSignedIn() && canReadPost();
      allow create: if isSignedIn() && request.resource.data.ownerUid == me();
      allow delete: if isSignedIn() && resource.data.ownerUid == me();

      // 本人による編集。
      allow update: if isSignedIn() && resource.data.ownerUid == me()
        && changedKeys().hasOnly(['caption', 'itemTags', 'genres', 'season', 'visibility', 'placeName']);

      // いいね/コメントのカウンタは他人も動かす。1ずつしか変えられないよう縛る。
      allow update: if isSignedIn() && canReadPost()
        && changedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount >= 0
        && (request.resource.data.likeCount == resource.data.likeCount + 1
            || request.resource.data.likeCount == resource.data.likeCount - 1);

      allow update: if isSignedIn() && canReadPost()
        && changedKeys().hasOnly(['commentCount'])
        && request.resource.data.commentCount >= 0
        && (request.resource.data.commentCount == resource.data.commentCount + 1
            || request.resource.data.commentCount == resource.data.commentCount - 1);

      // likes: ドキュメントIDをUIDに固定しているので、1人1いいねが構造的に保証される。
      match /likes/{likeUid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && me() == likeUid && request.resource.data.uid == me();
        allow delete: if isSignedIn() && me() == likeUid;
        allow update: if false;
      }

      // saves: likes と同じ形。ID を uid に固定して1人1保存にする。
      // 誰が保存したかは本人だけが分かればよいので、読めるのは自分の行だけ。
      match /saves/{saveUid} {
        allow read: if isSignedIn() && me() == saveUid;
        allow create: if isSignedIn() && me() == saveUid && request.resource.data.uid == me();
        allow delete: if isSignedIn() && me() == saveUid;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == me();
        allow delete: if isSignedIn() && resource.data.uid == me();
        allow update: if false;
      }
    }

    // chatThreads(DM): 参加者だけ。E2E暗号化はしない方針(Instagram の DM 相当)。
    match /chatThreads/{tid} {
      // 存在しないドキュメントを get したとき resource は null になる。そこで
      // resource.data を無条件に触ると評価エラーになり「権限なし」として拒否される。
      // ensureChatThread は作成前に必ず存在確認の get をするため、これを許さないと
      // スレッドが1つも作れず、DMが丸ごと使えなくなる(実際にそうなっていた)。
      allow get: if isSignedIn() && (resource == null || me() in resource.data.memberUids);
      allow list: if isSignedIn() && me() in resource.data.memberUids;
      // ブロックしている/されている相手とはスレッドを作れない。
      // DM は相手の画面に直接届くので、ここだけはルールでも止める。
      function notBlockedPair(members) {
        return !exists(/databases/$(database)/documents/blocks/$(me() + '__' + members[0]))
          && !exists(/databases/$(database)/documents/blocks/$(me() + '__' + members[1]))
          && !exists(/databases/$(database)/documents/blocks/$(members[0] + '__' + me()))
          && !exists(/databases/$(database)/documents/blocks/$(members[1] + '__' + me()));
      }

      allow create: if isSignedIn()
        && me() in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == 2
        && notBlockedPair(request.resource.data.memberUids);
      allow update: if isSignedIn() && me() in resource.data.memberUids
        && changedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderUid']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && me() in get(/databases/$(database)/documents/chatThreads/$(tid)).data.memberUids;
        allow create: if isSignedIn()
          && request.resource.data.senderUid == me()
          && me() in get(/databases/$(database)/documents/chatThreads/$(tid)).data.memberUids;
        allow update, delete: if false;
      }
    }
  }
}
