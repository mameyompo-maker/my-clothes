rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // users: 自分のドキュメントは自由に更新できる。他人のドキュメントは、招待コードを
    // 使って「自分自身をfriendUidsに追加する」ことだけ許可する(Cloud Functions不要、
    // Blazeプラン不要で友達追加が完結する。詳しくは lib/firestore.ts の redeemInviteCode)。
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendUids'])
        && request.resource.data.friendUids.size() == resource.data.friendUids.size() + 1
        && request.resource.data.friendUids.hasAll(resource.data.friendUids)
        && request.auth.uid in request.resource.data.friendUids;
    }

    // closetItems: 身内利用規模なので閲覧はサインイン済みなら誰でも可、書き込みは所有者のみ。
    match /closetItems/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // facePatterns: 本人しか読み書きできない(合成処理は Cloud Functions が Admin SDK で読む)。
    match /facePatterns/{patternId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // outfitPosts: 投稿者本人 or 共有された友達だけ読める。作成後の更新はクライアントから不可
    // (AI合成を有効化した場合、Cloud Functions が Admin SDK 経由でのみ composedImageUrl を書き込む)。
    match /outfitPosts/{postId} {
      allow read: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.sharedWithUids);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;

      // votes: 投稿を見られる友達だけが、本人名義で1票だけ投じられる(投稿者本人は不可)。
      match /votes/{voterUid} {
        allow read: if isSignedIn()
          && (get(/databases/$(database)/documents/outfitPosts/$(postId)).data.ownerUid == request.auth.uid
              || request.auth.uid in get(/databases/$(database)/documents/outfitPosts/$(postId)).data.sharedWithUids);
        allow create, update: if isSignedIn() && request.auth.uid == voterUid
          && request.resource.data.voterUid == voterUid
          && request.resource.data.postId == postId
          && get(/databases/$(database)/documents/outfitPosts/$(postId)).data.ownerUid != request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/outfitPosts/$(postId)).data.sharedWithUids;
        allow delete: if false;
      }
    }
  }
}
